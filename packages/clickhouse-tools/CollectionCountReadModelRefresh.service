[Unit]
Description=AtpDashboard ClickHouse collection_count read model refresh
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/AtpDashboard
EnvironmentFile=-/etc/atpdashboard/clickhouse.env
ExecStart=pnpm refresh:collection-count -- --confirm-production --stale-running-minutes 60 --recent-hours 72
StandardOutput=append:/var/log/CollectionCountReadModelRefresh.log
StandardError=append:/var/log/CollectionCountReadModelRefresh.log
