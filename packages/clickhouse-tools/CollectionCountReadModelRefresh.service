[Unit]
Description=LEGACY DISABLED-ONLY AtpDashboard ClickHouse collection_count full read model refresh
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/AtpDashboard
EnvironmentFile=-/etc/atpdashboard/clickhouse.env
ExecStart=pnpm refresh:collection-count-legacy -- --confirm-production --stale-running-minutes 60 --recent-hours 72
StandardOutput=append:/var/log/CollectionCountReadModelRefresh.log
StandardError=append:/var/log/CollectionCountReadModelRefresh.log
